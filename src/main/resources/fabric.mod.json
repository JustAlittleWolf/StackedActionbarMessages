{
  "schemaVersion": 1,
  "id": "stackedactionbarmessages",
  "version": "${version}",
  "name": "StackedActionbarMessages",
  "description": "Stacks actionbar messages so they stay readable",
  "authors": [
    "JustAlittleWolf"
  ],
  "contact": {
    "sources": "https://github.com/JustAlittleWolf/StackedActionbarMessages"
  },
  "license": "MIT",
  "icon": "assets/stackedactionbarmessages/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "me.wolfii.stackedactionbarmessages.client.StackedActionbarMessagesClient"
    ],
    "modmenu": [
      "me.wolfii.stackedactionbarmessages.client.ModMenuIntegration"
    ]
  },
  "mixins": [
    "stackedactionbarmessages.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "fabric-api": "*",
    "minecraft": ">=${minecraft_version}",
    "yet_another_config_lib_v3": ">=3.9.0"
  },
  "suggests": {
    "modmenu": "*"
  }
}
